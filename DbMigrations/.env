SELECTED_ENVIRONMENT=local
FLYWAY_IMAGE_TAG=11.15.0-alpine
FLYWAY_INSTALLED_BY=docker-compose@${USER:-${USERNAME:-${LOGNAME:-unknown-user}}}/${HOST:-${HOSTNAME:-${COMPUTERNAME:-unknown-computer}}}
FLYWAY_LOCATIONS=filesystem:/flyway/sql
FLYWAY_CONFIG_FILES=/flyway/conf/flyway.keep.toml,/flyway/conf/local.DB.flyway.toml
