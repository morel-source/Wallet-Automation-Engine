<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <EmbeddedResource Update="DomainErrors.resx">
        <Generator>ResXFileCodeGenerator</Generator>
        <LastGenOutput>DomainErrors.Designer.cs</LastGenOutput>
      </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
      <Compile Update="DomainErrors.Designer.cs">
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
        <DependentUpon>DomainErrors.resx</DependentUpon>
      </Compile>
      <Compile Remove="Requests\TransactionRequest.cs" />
    </ItemGroup>

</Project>
